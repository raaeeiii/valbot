{
  "name": "valbot",
  "description": "Intelligent AI Chatbot Assistant - Modern React + TypeScript chatbot interface by Valbit",
  "version": "1.0.0",
  "author": "Valbit (Rahib RK) <contact@valbit.in>",
  "homepage": "https://valbot.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/raaeeiii/valbot.git"
  },
  "keywords": [
    "ai",
    "chatbot",
    "react",
    "typescript",
    "tailwindcss",
    "valbit"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && node secure-chat.js",
    "dev:both": "concurrently \"npm run dev:backend\" \"npm run dev\" --names \"BACKEND,FRONTEND\" --prefix-colors \"bgBlue.bold,bgGreen.bold\" --kill-others-on-fail",
    "dev:both:windows": "concurrently \"cd backend && node secure-chat.js\" \"vite\" --names \"BACKEND,FRONTEND\" --prefix-colors \"bgBlue.bold,bgGreen.bold\" --kill-others-on-fail",
    "dev:start": "node start-dev.js",
    "start:servers": "node launch-backend.js & npm run dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node scripts/start.cjs",
    "email:report": "node scripts/report.js"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@formspree/react": "^3.0.0",
    "@headlessui/react": "^2.2.6",
    "@heroicons/react": "^2.2.0",
    "@types/react-scroll": "^1.8.10",
    "dotenv": "^17.2.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.532.0",
    "nodemailer": "^7.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.7.1",
    "react-scroll": "^1.9.3",
    "react-syntax-highlighter": "^15.5.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "terser": "^5.43.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
